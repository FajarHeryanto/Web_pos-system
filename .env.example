# Supabase Dashboard > Connect > Connection string > URI
# Transaction Pooler port 6543 biasanya direkomendasikan untuk serverless.
# Ganti [YOUR-PASSWORD] dengan database password; URL-encode karakter khusus.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Rahasia JWT acak minimal 32 karakter; buat dengan: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Opsional: origin frontend yang diizinkan, pisahkan dengan koma.
# POS_CORS_ORIGINS=https://pos-example.vercel.app,http://localhost:8080

# Opsional: lokasi binary jika tidak di bin/processor atau bin/reporter.
# C_PROCESSOR_PATH=bin/processor
# COBOL_REPORTER_PATH=bin/reporter

# Port server lokal.
PORT=8080
